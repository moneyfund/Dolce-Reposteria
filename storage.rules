rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Propietario único: correo verificado y sesión con Google.
    // Firebase valida estas propiedades en el ID token firmado.
    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'norvingarcia220@gmail.com'
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    // Solo fotografías optimizadas de hasta 8 MiB.
    function validImage() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 8 * 1024 * 1024
        && request.resource.contentType.matches(
          'image/(jpeg|png|webp)'
        );
    }

    // Fotografía de un producto. Estos archivos son públicos
    // porque se mostrarán en el catálogo de la tienda.
    match /catalog/products/{productId}/{fileName} {
      allow get: if true;
      allow list: if false;
      allow create, update: if isOwner() && validImage();
      allow delete: if isOwner();
    }

    // Banners y fotografías de promociones públicas.
    match /catalog/promotions/{promotionId}/{fileName} {
      allow get: if true;
      allow list: if false;
      allow create, update: if isOwner() && validImage();
      allow delete: if isOwner();
    }

    // Referencias visuales para pedidos personalizados.
    // Por ahora: solo personal autorizado. No permitir que
    // visitantes anónimos carguen fotos sin protección antiabuso.
    match /order-references/{orderId}/{fileName} {
      allow get: if isOwner();
      allow list: if false;
      allow create, update: if isOwner() && validImage();
      allow delete: if isOwner();
    }

    // Todas las demás rutas permanecen cerradas.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
